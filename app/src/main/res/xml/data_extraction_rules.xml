<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer of the shop data. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="shop.json" />
        <include domain="sharedpref" path="shop.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="shop.json" />
        <include domain="sharedpref" path="shop.xml" />
    </device-transfer>
</data-extraction-rules>
