<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+: keep the app below the status bar and above the gesture bar
         (instead of drawing behind them), so the shop header is never covered. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#1E3A8A</item>
        <item name="android:colorPrimaryDark">#1E3A8A</item>
        <item name="android:colorAccent">#1E40AF</item>
        <item name="android:statusBarColor">#1E3A8A</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
